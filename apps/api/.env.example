# AuditFlow API — Environment Variables
# Copy to .env for local development

# App
APP_ENV=development
SECRET_KEY=change-me-in-production-use-32-char-random-string
ALLOWED_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/auditflow

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# AI
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Vector DB (pgvector by default; swap for Pinecone at scale)
VECTOR_BACKEND=pgvector
PINECONE_API_KEY=
PINECONE_INDEX=auditflow

# Integrations — Google Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Integrations — Notion
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Integrations — GitHub
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Integrations — Jira
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# AWS (for S3 report storage + Config integration)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_REPORTS=auditflow-reports-dev

# Observability
SENTRY_DSN=
LOG_LEVEL=INFO
